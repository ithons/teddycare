# Tune Studio API (OpenAI Proxy)
# Get your Tune Studio API Key here: https://tune.studio/account/api-keys
TUNE_STUDIO_API_KEY=your_tune_studio_api_key

# Clerk Authentication
# Create organizations named 'doctor' and 'patient' for role-based access
# Get your keys from: https://dashboard.clerk.com/
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_SECRET=your_clerk_secret_key

# Terra API for Health Data Integration
# Sign up at: https://tryterra.co/
TERRA_DEV_ID=your_terra_dev_id
TERRA_API_KEY=your_terra_api_key
TERRA_WEBHOOK_SECRET=your_terra_webhook_secret

# Database Configuration
# For local development, this points to a SQLite database
DATABASE_URL="file:./dev.db"

# Optional: Vercel Deployment
# Automatically set by Vercel during deployment
VERCEL_URL=your_vercel_url
